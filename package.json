{
  "name": "ethio-phone-validate",
  "version": "1.0.0",
  "description": "Enterprise-grade, zero-dependency TypeScript library for validating, parsing, normalizing, formatting, and identifying Ethiopian mobile phone numbers (Ethio Telecom and Safaricom Ethiopia).",
  "author": "Eyob Begashaw <eyobbegashaw@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyobbegashaw/Ready-Real-Time-Collaboration-Tool.git"
  },
  "bugs": {
    "url": "https://github.com/eyobbegashaw/Ready-Real-Time-Collaboration-Tool/issues"
  },
  "homepage": "https://github.com/eyobbegashaw/Ready-Real-Time-Collaboration-Tool#readme",
  "keywords": [
    "ethiopia",
    "ethiopian-phone",
    "ethio-telecom",
    "safaricom-ethiopia",
    "phone-number",
    "validator",
    "phone-validation",
    "e164",
    "telecom",
    "typescript",
    "normalization",
    "telecommunication"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
